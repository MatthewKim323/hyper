# Copy to .env.local (gitignored) and fill in. See lib/backend/README.md.

# Sign-in. Without this the frontend has no bearer token, so every authenticated
# backend call returns 401 and onboarding reports "service unavailable". Use the
# publishable key that pairs with the backend's CLERK_ISSUER, and make sure this
# site's origin is listed in the backend's CLERK_AUTHORIZED_PARTIES.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Remember onboarding completion across reloads. The code default re-runs it on
# every page load, which is a testing convenience (lib/onboarding/interface.ts).
NEXT_PUBLIC_ALWAYS_ONBOARD=0

# Where the Next rewrite proxies /api/onboarding/* (default http://127.0.0.1:8000).
# ONBOARDING_BACKEND_URL=

# Demo only. Shows every source in the Access relic as connected for the synthetic company, whose data was
# imported from fixtures rather than pulled through the connectors. Leave unset anywhere real.
# NEXT_PUBLIC_DEMO_CONNECTED=1

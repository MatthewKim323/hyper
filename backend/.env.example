DEEPGRAM_API_KEY=
# Optional: omit both to use Deepgram's managed default LLM.
DEEPGRAM_THINK_PROVIDER=
DEEPGRAM_THINK_MODEL=
AI_GATEWAY_API_KEY=
EVALUATOR_SECRET=replace-with-a-random-shared-secret
EVALUATOR_URL=http://127.0.0.1:8001
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:3888,http://localhost:3888
DATABASE_PATH=var/onboarding.sqlite
# Clerk instance Frontend API URL, from your Clerk dashboard.
CLERK_ISSUER=
CLERK_PUBLISHABLE_KEY=
# Exact frontend origins allowed in the JWT azp claim. Include the console and product UI.
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:8000,http://localhost:8000
# Optional JWT audience if configured in Clerk.
CLERK_AUDIENCE=
# Optional comma-separated verified Clerk user IDs sharing the Meridian demo workspace.
# Set before their first sign-in. Never use email domains as authorization.
DEMO_USER_IDS=

# Data stack: see STORAGE.md and .env.data.example for working local Compose values.
# DATABASE_URL takes precedence over the legacy DATABASE_PATH.
DATABASE_URL=
S3_BUCKET=hyper-sources
S3_ENDPOINT_URL=
S3_ADDRESSING_STYLE=path
AWS_REGION=us-east-1
# Use IAM or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY on the backend.
ELASTICSEARCH_URL=http://127.0.0.1:19200
ELASTICSEARCH_INDEX=hyper-evidence-v1
ELASTICSEARCH_API_KEY=
ELASTIC_INFERENCE_ID=
ELASTIC_SEMANTIC_DATASETS=

# Optional separate inference deployment for interactive queries (same embedding model).
ELASTIC_SEARCH_INFERENCE_ID=

# Scheduled simulator: exact AI Gateway model identifier, e.g. provider/model.
# Uses AI_GATEWAY_API_KEY above. LLM runs fail closed when either is missing.
SIMULATOR_MODEL=

# Real connectors: persistent Fernet key. Back up in your secret manager; never commit.
CONNECTOR_ENCRYPTION_KEY=
CONNECTOR_CALLBACK_BASE_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Text model drafts concern cards; Jev independently evaluates them.
CONCERN_MODEL=openai/gpt-5-mini

# Financial artifact authoring (Jev separately evaluates the resulting artifact)
ARTIFACT_MODEL=
# Devin v3 service credentials; keep server-side
DEVIN_API_KEY=
DEVIN_ORG_ID=
# Public HTTPS address reachable from Devin cloud sessions
AGENT_PUBLIC_BASE_URL=
DEVIN_SESSION_ACU_LIMIT=5
# Cumulative launch cap per application organization (including replacement coordinators)
DEVIN_MAX_SESSIONS_PER_ORG=10

# Elastic Serverless: provision endpoints first; leave blank for existing keyword/ELSER mode.
ELASTIC_RERANK_INFERENCE_ID=
# ELASTIC_INFERENCE_ID=.jina-embeddings-v5-text-small (verify project availability)
# ELASTIC_RERANK_INFERENCE_ID=.jina-reranker-v3.5 (verify project availability)
ELASTIC_KIBANA_URL=
ELASTIC_KIBANA_API_KEY=
ELASTIC_KIBANA_SPACE=
# This first deployment is explicitly scoped to one app organization.
ELASTIC_AGENT_ORGANIZATION_ID=
ELASTIC_WORKFLOW_ID=
ELASTIC_CALLBACK_SECRET=
ELASTIC_AUTO_INVESTIGATE=false
# Kibana HTTP connector with backend base URL and encrypted Bearer callback secret.
ELASTIC_CALLBACK_CONNECTOR_ID=
ELASTIC_MAX_ACTIVE_INVESTIGATIONS=2

# Deepgram coordinates dashboard requests; opt in only for the legacy Devin coordinator.
DEVIN_COORDINATOR_ENABLED=false

# Preferred specialist delegation; legacy workflow remains available explicitly.
ELASTIC_AGENT_TRANSPORT=a2a
# Returned agent_id from: python -m app.elastic_setup provision --transport a2a
ELASTIC_A2A_AGENT_ID=

# Copy to .env.data for local CLI/testing. Merge into .env for the API and worker.
DATABASE_URL=postgresql+psycopg://hyper:hyper-local-only@127.0.0.1:15432/hyper
S3_ENDPOINT_URL=http://127.0.0.1:19000
S3_BUCKET=hyper-sources
S3_ADDRESSING_STYLE=path
AWS_ACCESS_KEY_ID=hyper-local
AWS_SECRET_ACCESS_KEY=hyper-local-only-password
AWS_REGION=us-east-1
ELASTICSEARCH_URL=http://127.0.0.1:19200
ELASTICSEARCH_INDEX=hyper-evidence-v1
# Empty explicitly selects keyword mode. Set a provisioned inference endpoint for hybrid.
ELASTIC_INFERENCE_ID=

# Optional separate inference deployment for interactive queries (same embedding model).
ELASTIC_SEARCH_INFERENCE_ID=
